    Protected Sub fbtn_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles fbtn.Click
        dta = oh.ExecuteDataSet("select t.query from hrm_report_master t where t.query_id=105 and t.firm_id=99").Tables(0)
        Dim vysha() As String = dta.Rows(0)(0).ToString.Split("$")
        Dim dt3 As DataTable = oh.ExecuteDataSet(vysha(1).Split("@")(1)).Tables(0)
        If dt3.Rows.Count > 0 Then
            GridView2.DataSource = dt3
            GridView2.DataBind()
            Response.ClearContent()
            Response.Buffer = True
            Response.AddHeader("content-disposition", String.Format("attachment; filename={0}", "Master Data" + " " + DateTime.Now.ToString("dd-MMMM-yyyy" + " " + "hh:mm tt") + ".xls"))
            Response.ContentType = "application/ms-excel"
            Dim sw As New StringWriter()
            Dim htw As New HtmlTextWriter(sw)
            GridView2.AllowPaging = False
            GridView2.HeaderRow.Style.Add("background-color", "#FFFFFF")
            For i As Integer = 0 To GridView2.HeaderRow.Cells.Count - 1
                GridView2.HeaderRow.Cells(i).Style.Add("background-color", "#00BFFF")
            Next
            GridView2.RenderControl(htw)
            Response.Write(sw.ToString())
            Response.[End]()
        End If
    End Sub
