            Me.chk_age.Checked = False
            Me.chk_date.Checked = False

        End If
    End Sub
#End Region

#Region "state- checked changed"
    Protected Sub chk_state_CheckedChanged(ByVal sender As Object, ByVal e As System.EventArgs)
        If Me.Chk_state.Checked = True Then
            Me.cmb_state.Enabled = True
            Me.chk_district.Checked = False
            Dim dtd As DataTable = oh.ExecuteDataSet("select district_id,district_name from district_master where state_id='" & Me.cmb_state.SelectedValue & "' order by district_name").Tables(0)
            Me.cmb_district.DataSource = dtd
            Me.cmb_district.DataTextField = dtd.Columns(1).ColumnName
            Me.cmb_district.DataValueField = dtd.Columns(0).ColumnName
            Me.cmb_district.DataBind()
        End If
    End Sub
#End Region

    Protected Sub cmb_state_SelectedIndexChanged(ByVal sender As Object, ByVal e As System.EventArgs)
        Me.chk_district.Checked = False
