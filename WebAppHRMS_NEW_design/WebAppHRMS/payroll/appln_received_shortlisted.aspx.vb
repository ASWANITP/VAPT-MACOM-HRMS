#Region "load"
    Protected Sub Page_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load

        Dim cs As String = "var cont_name;cont_name='" & Me.chk_date.ClientID & "';"
        Page.ClientScript.RegisterClientScriptBlock(Me.GetType, "var", cs, True)

        If Not IsPostBack Then
            If Session("access_id") <> 33 Then
                Server.Transfer("../show_err.aspx")
                Exit Sub
            End If
            'enable fields
            Me.cmb_state.Enabled = False
            Me.cmb_district.Enabled = False
            Me.cmb_gender.Enabled = False
            Me.cmb_qualification.Enabled = False
            Me.txt_agefrom.Enabled = False
            Me.txt_ageto.Enabled = False
            Me.Txt_dtfrom.Enabled = False
            Me.Txt_dtto.Enabled = False
            Me.chk_district.Checked = False
            Me.chk_age.Checked = False
            Me.chk_all.Checked = False
            Me.chk_date.Checked = False
            Me.chk_gender.Checked = False
            Me.chk_qualification.Checked = False
            Me.Chk_state.Checked = False

            Dim dt As DataTable = oh.ExecuteDataSet("select state_id,state_name from state_master order by state_name").Tables(0)
            Me.cmb_state.DataSource = dt
            Me.cmb_state.DataTextField = dt.Columns(1).ColumnName
            Me.cmb_state.DataValueField = dt.Columns(0).ColumnName
            Me.cmb_state.DataBind()

            Dim dtd As DataTable = oh.ExecuteDataSet("select district_id,district_name from district_master where state_id='" & Me.cmb_state.SelectedValue & "' order by district_name").Tables(0)
            Me.cmb_district.DataSource = dtd
            Me.cmb_district.DataTextField = dtd.Columns(1).ColumnName
            Me.cmb_district.DataValueField = dtd.Columns(0).ColumnName
            Me.cmb_district.DataBind()


            Dim dt1 As DataTable = oh.ExecuteDataSet("select qualification_id,qualification from qualification_master order by qualification").Tables(0)
            Me.cmb_qualification.DataSource = dt1
            Me.cmb_qualification.DataTextField = dt1.Columns(1).ColumnName
            Me.cmb_qualification.DataValueField = dt1.Columns(0).ColumnName
            Me.cmb_qualification.DataBind()
            Me.Txt_dtfrom.Text = Format(Now.Date, "dd/MMM/yyyy")
            Me.Txt_dtto.Text = Format(Now.Date, "dd/MMM/yyyy")

        End If

        Me.Txt_dtfrom.Attributes.Add("onkeyup", "OnkeyUpChqDate('Txt_dtfrom')")
        Me.Txt_dtto.Attributes.Add("onkeyup", "OnkeyUpChqDate('Txt_dtto')")
    End Sub
#End Region

#Region "checkbox ALL changed"
