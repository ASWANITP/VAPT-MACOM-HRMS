    Protected Sub chk_all_CheckedChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles chk_all.CheckedChanged
        If (Me.chk_all.Checked = True) Then
            Me.chk_post.Checked = True
            Me.chk_firm.Checked = True
            Me.chk_emp.Checked = True
            Me.chk_des.Checked = True
            Me.chk_dep.Checked = True
            Me.chk_branch.Checked = True
            Me.cmb_post.Visible = True
            Me.cmb_firm.Visible = True
            Me.cmb_des.Visible = True
            Me.cmb_dep.Visible = True
            Me.cmb_branch.Visible = True
            Me.cmb_type.Visible = True
            branch_fill()
            firm_fill()
            designation_fill()
            department_fill()
            post_fill()
        Else
            Me.chk_post.Checked = False
            Me.chk_firm.Checked = False
            Me.chk_emp.Checked = False
            Me.chk_des.Checked = False
            Me.chk_dep.Checked = False
            Me.chk_branch.Checked = False
            Me.cmb_post.Visible = False
            Me.cmb_firm.Visible = False
            Me.cmb_des.Visible = False
            Me.cmb_dep.Visible = False
            Me.cmb_branch.Visible = False
            Me.cmb_type.Visible = False
        End If
    End Sub

