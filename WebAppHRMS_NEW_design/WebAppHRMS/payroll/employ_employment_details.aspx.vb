Imports System.Data
Imports system.data.oracleclient
Partial Class posting_reports_employ_employment_details_f4a43e3a6037
    Inherits System.Web.UI.Page
    Dim oh As New Helper.Oracle.OracleHelper
    Dim dt As New DataTable
    Dim sql As String



    Sub designation_fill()
        Dim sql As String
        sql = "select a.designation,a.designation_id from designation_master a order by a.designation"

        dt = oh.ExecuteDataSet(sql).Tables(0)
        If dt.Rows.Count > 0 Then
            Me.cmb_des.DataSource = dt
            Me.cmb_des.DataTextField = dt.Columns(0).ColumnName
            Me.cmb_des.DataValueField = dt.Columns(1).ColumnName
            Me.cmb_des.DataBind()
        End If
    End Sub

    Sub post_fill()
        Dim sql As String
        Dim s As Integer
        s = Session("firm_id")
        If s = 6 Or s = 14 Or s = 31 Or s = 32 Then
            sql = "select distinct p.post_name,p.post_id from post_mst p,employee_master em,employ_firm ef where em.post_id = p.post_id and em.emp_code = ef.emp_code and ef.firm_id in(6,14,31,32) and em.status_id=1 order by p.post_name"
        Else

            '    sql = "select post_name,post_id from post_mst order by post_name"
            sql = "select distinct p.post_name,p.post_id from post_mst p,employee_master em,employ_firm ef where em.post_id = p.post_id and em.emp_code = ef.emp_code and ef.firm_id = ' " & Session("firm_id") & " ' and em.status_id=1 order by p.post_name"
        End If
        dt = oh.ExecuteDataSet(sql).Tables(0)
        If dt.Rows.Count > 0 Then
            Me.cmb_post.DataSource = dt
            Me.cmb_post.DataTextField = dt.Columns(0).ColumnName
            Me.cmb_post.DataValueField = dt.Columns(1).ColumnName
            Me.cmb_post.DataBind()
        End If
    End Sub

    Sub branch_fill()
        Dim sql As String
        Dim s As Integer
        s = Session("firm_id")
        If s = 6 Or s = 14 Or s = 31 Or s = 32 Then

            sql = "select b.branch_name, b.branch_id from branch_master b   where b.firm_id in (6,14,31,32) union select b.branch_name, b.branch_id from branch_master b where b.branch_id=0"
        Else

            '  sql = "select branch_name, branch_id from branch_master union select branch_name,old_id from before_completion where branch_id is null order by branch_name"
            sql = "select b.branch_name, b.branch_id from branch_master b   where b.firm_id = ' " & Session("firm_id") & " ' union select b.branch_name, b.branch_id from branch_master b where b.branch_id=0"
        End If
        dt = oh.ExecuteDataSet(sql).Tables(0)
        If dt.Rows.Count > 0 Then
            Me.cmb_branch.DataSource = dt
            Me.cmb_branch.DataTextField = dt.Columns(0).ColumnName
            Me.cmb_branch.DataValueField = dt.Columns(1).ColumnName
            Me.cmb_branch.DataBind()
        End If
    End Sub

    Sub department_fill()

        Dim sql As String
        ' sql = "select dep_name,dep_id from department_mst order by dep_name"
        Dim s As Integer
        s = Session("firm_id")
        If s = 6 Or s = 14 Or s = 31 Or s = 32 Then
            sql = "select distinct d.dep_name, d.dep_id from department_mst d,employ_firm ef,employee_master em where  em.department_id = d.dep_id and  em.emp_code = ef.emp_code and ef.firm_id in(6,14,31,32) and em.status_id = 1 order by d.dep_name"
        Else
            sql = "select distinct d.dep_name, d.dep_id from department_mst d,employ_firm ef,employee_master em where  em.department_id = d.dep_id and  em.emp_code = ef.emp_code and ef.firm_id = '" & Session("firm_id") & "'  and em.status_id = 1 order by d.dep_name"
        End If
        dt = oh.ExecuteDataSet(sql).Tables(0)
        If dt.Rows.Count > 0 Then
            Me.cmb_dep.DataSource = dt
            Me.cmb_dep.DataTextField = dt.Columns(0).ColumnName
            Me.cmb_dep.DataValueField = dt.Columns(1).ColumnName
            Me.cmb_dep.DataBind()
        End If
    End Sub
    Sub firm_fill()
        Dim sql As String
        'sql = "select firm_name,firm_id from firm_master order by firm_name"
        Dim s As Integer
        s = Session("firm_id")
        If s = 6 Or s = 14 Or s = 31 Or s = 32 Then
