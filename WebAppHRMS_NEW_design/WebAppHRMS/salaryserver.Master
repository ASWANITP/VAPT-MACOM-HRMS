                            <strong><em><span style="font-size: 18pt; color: #fff; font-family: Tunga; background-color: DarkRed">
                                <asp:ScriptManager ID="mail_master_script_mng" runat="server">
                                </asp:ScriptManager>
                                Manappuram Comptech &amp; Consultants Ltd.</span></em></strong></td>
                    </tr>
