<!DOCTYPE html>
<html lang="en">
<head runat="server">
        <link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
/>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: "Poppins";
            overflow: hidden;
            background-color: whitesmoke;
        }

        /* Top Navigation Container */
        .center-menu {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            padding: 12px 0;
            background-color: midnightblue;
            border-radius: 5px;
        }

            /* Menu Items */
            .center-menu .menu-item {
                flex: 1;
                position: relative;
                padding: 5px;
                text-align: center;
                background-color: midnightblue;
                color: white;
                cursor: pointer;
                border-radius: 5px;
                transition: background 0.2s;
            }

            .center-menu .menu-item_click {
                flex: 1;
                position: relative;
                padding: 5px;
                text-align: center;
                background-color: midnightblue;
                color: white;
                cursor: pointer;
                border-radius: 5px;
                transition: background 0.2s;
            }

            .center-menu .menu-item:hover {
                background: rgba(255, 255, 255, 0.15);
            }

        /* Dropdown Modal (for regular items) */
        .menu-item:hover > .modal {
            display: block;
        }

        .modal {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 209px;
            background-color: white;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.5);
            z-index: 1000;
            border-radius: 5px;
            margin-top: 31px;
        }

        .modal-content {
            max-height: 300px;
            overflow-y: auto;
        }

            .modal-content a {
                display: block;
                padding: 5px;
                background-color: whitesmoke;
                color: #626477;
                text-decoration: none;
                text-align: left;
                border-radius: 5px;
            }

                .modal-content a:hover {
                    background-color: #C3D9EF;
                    color: #626477;
                }

        /* Submenu (for "Reports" menu) */
        .submenu {
            display: none;
            position: fixed;
            min-width: 150px;
            background-color: whitesmoke;
            overflow-y: auto;
            z-index: 9999;
            border-radius: 5px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.5);
        }

            .reports-menu:hover > .submenu,
            .submenu:hover {
                display: block;
            }

        /* Styling Overrides for Reports Menu Item */
        .menu-item.reports-menu {
            background-color: whitesmoke;
            color: #626477;
            text-align: left;
        }

            .menu-item.reports-menu a {
                text-align: left;
            }

            .menu-item.reports-menu:hover {
                background-color: #C3D9EF;
                color: #626477;
            }


        .scroll-box {
            display: none;
            height: 20px;
            background: rgba(0, 0, 0, 0.1);
            text-align: left;
            line-height: 20px;
            cursor: pointer;
            font-size: 12px;
            color: #555;
            user-select: none;
            border-radius: 5px;
        }

            .scroll-box:hover {
                background: rgba(0, 0, 0, 0.3);
            }

            .scroll-box[data-direction="-1"] {
                top: 0;
            }

            .scroll-box[data-direction="1"] {
                bottom: 0;
            }
    </style>
    <script>
        function updateTime() {
            var now = new Date();
            // Format hours, minutes, seconds as you wish.
            var hours = now.getHours().toString().padStart(2, '0');
            var minutes = now.getMinutes().toString().padStart(2, '0');
            var seconds = now.getSeconds().toString().padStart(2, '0');
            var formattedTime = hours + ":" + minutes + ":" + seconds;

            // Assuming your label has rendered an element with the ID 'lbl_time'
            document.getElementById("lbl_time").innerText = formattedTime;
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateTime(); // update immediately on DOM ready
            setInterval(updateTime, 1000); // then update every second
        });

        document.addEventListener("DOMContentLoaded", function () {
            debugger;
            document.querySelectorAll(".reports-menu").forEach(menu => {
                const submenu = menu.querySelector(".submenu");

                menu.addEventListener("mouseenter", function () {
                    debugger;
                    const rect = menu.getBoundingClientRect();
                    submenu.style.display = "block";

                    let availableSpaceBelow = window.innerHeight - rect.bottom;
                    let availableSpaceAbove = rect.top;
                    let submenuHeight = submenu.scrollHeight;
                    let modalContent = submenu.querySelector(".modal-content");
                    let scrollBoxes = submenu.querySelectorAll(".scroll-box");
                    let totalScrollBoxHeight = 0;

                    scrollBoxes.forEach(box => {
                        totalScrollBoxHeight += box.offsetHeight; // Use offsetHeight to get the visible height
                    });
                    submenuHeight = submenuHeight - totalScrollBoxHeight;
                    if (submenuHeight > availableSpaceBelow && availableSpaceAbove > submenuHeight) {
                        // Open submenu upwards
                        submenu.style.top = `${rect.top - submenuHeight}px`;
                    } else {
                        // Default to opening downwards
                        submenu.style.top = `${rect.top}px`;

                    }

                    // Prevent submenu from overflowing the viewport horizontally
                    let availableSpaceRight = window.innerWidth - rect.right;
                    if (availableSpaceRight < submenu.offsetWidth) {
                        submenu.style.left = `${rect.left - submenu.offsetWidth}px`; // Move left if needed
                    } else {
                        submenu.style.left = `${rect.right}px`; // Default position
                    }



                    if (modalContent.scrollHeight > modalContent.clientHeight) {
                        scrollBoxes.forEach(box => box.style.display = "block");
                    } else {
                        scrollBoxes.forEach(box => box.style.display = "none");
                    }
                });

                menu.addEventListener("mouseleave", function () {
                    setTimeout(() => {
                        if (!submenu.matches(":hover")) {
                            submenu.style.display = "none";
                        }
                    }, 200);
                });

                submenu.addEventListener("mouseleave", function () {
                    submenu.style.display = "none";
                });
            });
        });




        function showModal(modal, parent) {
            debugger;
            modal.style.display = "block";
            let rect = parent.getBoundingClientRect();
            let modalRect = modal.getBoundingClientRect();
            let windowWidth = window.innerWidth;
            let windowHeight = window.innerHeight;
            modal.style.top = `${rect.bottom}px`;
            if (rect.top - modalRect.height != 0 || rect.top - modalRect.height < 0) {
                modal.style.top = "0";
            }


            let modalContent = modal.querySelector(".modal-content");
            let availableHeight = windowHeight - rect.bottom; // Space from menu to bottom
            modalContent.style.maxHeight = `${availableHeight}px`;
            modalContent.style.overflowY = "auto"; // Enable scrolling if needed



            // Adjust bottom scroll-box position
            let bottomScrollBox = modal.querySelector('.scroll-box[data-direction="1"]');
            if (bottomScrollBox) {
                bottomScrollBox.style.position = "absolute";
                bottomScrollBox.style.bottom = "0px"; // Fix it at the bottom
                bottomScrollBox.style.width = "100%";
                bottomScrollBox.style.display = modalContent.scrollHeight > modalContent.clientHeight ? "block" : "none";
            }

            // Add padding to prevent overlap with last menu item
            let lastMenuItem = modalContent.lastElementChild;
            if (lastMenuItem) {
                lastMenuItem.style.marginBottom = bottomScrollBox.style.display === "block" ? "0px" : "0px";
            }

            let scrollBoxes = modal.querySelectorAll(".scroll-box");
            if (modalContent.scrollHeight > modalContent.clientHeight) {
                scrollBoxes.forEach(box => box.style.display = "block");
            } else {
                scrollBoxes.forEach(box => box.style.display = "none");
            }
        }

        function closeModal(modal) {
            modal.style.display = "none";
        }
        document.addEventListener("DOMContentLoaded", function () {
            debugger;
            document.querySelectorAll(".menu-item").forEach(menuItem => {
                let modal = menuItem.querySelector(".modal");
                if (modal) {
                    menuItem.addEventListener("mouseenter", function () {
                        showModal(modal, menuItem);
                    });
                    menuItem.addEventListener("mouseleave", function () {
                        setTimeout(() => {
                            if (!menuItem.matches(":hover") && !modal.matches(":hover")) {
                                closeModal(modal);
                            }
                        }, 200);
                    });
                    modal.addEventListener("mouseleave", function () {
                        closeModal(modal);
                    });

                }
            });

            // For each menu item that should trigger the modal on click.
            document.querySelectorAll(".menu-item_click").forEach(menuItem => {
                let modal = menuItem.querySelector(".modal");

                if (modal) {
                    // Toggle the modal when clicking on the menu item
                    menuItem.addEventListener("click", function (e) {
                        // Prevent the click from bubbling up so it doesn't trigger the document's click event.
                        e.stopPropagation();

                        // Close all other modals before toggling the current one.
                        document.querySelectorAll(".menu-item_click .modal").forEach(otherModal => {
                            if (otherModal !== modal) {
                                closeModal(otherModal);
                            }
                        });

                        // Toggle the clicked modal's visibility.
                        if (modal.style.display === "block") {
                            closeModal(modal);
                        } else {
                            showModal(modal, menuItem);
                        }
                    });

                    // Prevent clicks inside the modal from closing it
                    modal.addEventListener("click", function (e) {
                        e.stopPropagation();
                    });
                }
            });

            // Clicking anywhere outside the menu item/modal will close all modals.
            document.addEventListener("click", function () {
                document.querySelectorAll(".menu-item_click .modal").forEach(modal => {
                    closeModal(modal);
                });
            });

            /*''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''*/
            document.querySelectorAll(".scroll-box").forEach(scrollBox => {
                debugger;
                let interval;
                function startScrolling(modalContent, direction, speed) {
                    stopScrolling();
                    interval = setInterval(() => {
                        modalContent.scrollTop += direction * speed;
                    }, 50);
                }
                function stopScrolling() {
                    clearInterval(interval);
                }
                scrollBox.addEventListener("mouseenter", function () {
                    let modalContent = this.parentElement.querySelector(".modal-content");
                    if (modalContent) {
                        startScrolling(modalContent, parseInt(this.dataset.direction), 5);
                    }
                });
                scrollBox.addEventListener("mouseleave", stopScrolling);
                scrollBox.addEventListener("mousedown", function () {
                    let modalContent = this.parentElement.querySelector(".modal-content");
                    if (modalContent) {
                        startScrolling(modalContent, parseInt(this.dataset.direction), 5);
                    }
                });
                scrollBox.addEventListener("mouseup", stopScrolling);
            });
        });
    </script>
</head>
